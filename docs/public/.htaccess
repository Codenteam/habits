# Handle 404 errors within this directory
# Prevents parent website from handling 404s

# Enable RewriteEngine
RewriteEngine On

# Set the base for rewrites (subdirectory path)
RewriteBase /intersect/habits/

# Custom 404 error document (must use full path from site root)
ErrorDocument 404 /intersect/habits/404.html

<IfModule mod_rewrite.c>
    # Case 1: Directory exists but has NO index.html (VitePress asset dirs like /showcase/hello-world/)
    # mod_dir redirects /page to /page/ because the asset dir exists; serve the .html page instead.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html !-f
    RewriteRule ^(.+?)/?$ $1.html [L]

    # Case 2: No file or directory exists — clean URL support (serve page.html for /page)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)$ $1.html [L]

    # Fallback: show custom 404 for everything else that doesn't resolve
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /intersect/habits/404.html [L]
</IfModule>

# Allow CORS for all origins
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type"
</IfModule>

# Prevent directory listing
Options -Indexes

# Set proper MIME types
<IfModule mod_mime.c>
    AddType text/html .html
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json
</IfModule>

# Enable compression for better performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
