{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationDir": "./dist",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@habits/shared/*": ["../../core/src/*"],
      "@ha-bits/cortex-core/ui": ["../../cortex/core/src/ui/index.ts"],
      "@ha-bits/cortex-core/ui/*": ["../../cortex/core/src/ui/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
