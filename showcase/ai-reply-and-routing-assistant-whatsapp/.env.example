# OpenAI — message classification, risk assessment, and reply generation
HABITS_OPENAI_API_KEY=sk-...

# WhatsApp Cloud API
HABITS_WHATSAPP_ACCESS_TOKEN=
HABITS_WHATSAPP_PHONE_NUMBER_ID=
HABITS_WHATSAPP_VERIFY_TOKEN=

# Meta App Secret — verifies X-Hub-Signature-256 on inbound webhook POSTs (App settings → Basic)
HABITS_WHATSAPP_APP_SECRET=

# Session template — see README "Create a message template" (or docs/integrations/whatsapp Step 10)
HABITS_WHATSAPP_SESSION_TEMPLATE=hello_world
HABITS_WHATSAPP_SESSION_TEMPLATE_LANGUAGE=en_US

# Optional custom immediate acknowledgement sent before AI analysis
# HABITS_WHATSAPP_ACK_MESSAGE=

# Team phone numbers for routing (E.164, e.g. +14155238886)
HABITS_WHATSAPP_TEAM_SALES_PHONE=
HABITS_WHATSAPP_TEAM_SUPPORT_PHONE=
HABITS_WHATSAPP_TEAM_BILLING_PHONE=
HABITS_WHATSAPP_TEAM_TECHNICAL_PHONE=
HABITS_WHATSAPP_TEAM_HR_PHONE=
HABITS_WHATSAPP_TEAM_GENERAL_PHONE=
