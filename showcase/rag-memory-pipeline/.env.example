# OpenAI — chunk extraction and embeddings
HABITS_OPENAI_API_KEY=sk-...

# SQLite vector collection name (default: rag_memory)
HABITS_RAG_COLLECTION=rag_memory

# Base directory on the filesystem (absolute path, e.g. /tmp or /home/you/Desktop)
HABITS_RAG_BASE_DIR=

# Folder to watch, relative to HABITS_RAG_BASE_DIR (use "." to watch the base dir itself)
HABITS_RAG_FOLDER_PATH=rag-data
