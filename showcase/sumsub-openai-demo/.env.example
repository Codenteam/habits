# Copy to .env and fill in values ( .env is gitignored )

# Sumsub Sandbox credentials (Dashboard → Dev space → App tokens)
HABITS_SUMSUB_APP_TOKEN=
HABITS_SUMSUB_SECRET_KEY=
HABITS_SUMSUB_BASE_URL=https://api.sumsub.com

# Sumsub webhook signing secret (Dashboard → Dev space → Webhook manager → Secret key)
# Used to verify x-payload-digest on incoming webhooks at /webhook/v/sumsub
HABITS_SUMSUB_WEBHOOK_SECRET=

# SQLite database for persisted KYC customer records
HABITS_KYC_DATABASE=showcase/sumsub-openai-demo/sumsub-kyc.db

# Local AI — default qwen3.5-0.8b (requires local-ai-candle built from latentcollapse feat/quantized-qwen35)
HABITS_LOCAL_AI_MODEL=qwen3.5-0.8b
# Path to built @local-ai/node native addon (run: cd local-ai-candle/local-ai-node && npm run build:metal)
LOCAL_AI_NODE_PATH=local-ai-candle/local-ai-node

# Email (Gmail app password) for send-results-to-department
EMAIL_USER=
EMAIL_PASSWORD=
HABITS_SMTP_HOST=smtp.gmail.com
HABITS_SMTP_PORT=587
