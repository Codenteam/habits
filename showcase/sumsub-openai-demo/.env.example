# Copy to .env and fill in values ( .env is gitignored )

# Sumsub Sandbox credentials (Dashboard → Dev space → App tokens)
HABITS_SUMSUB_APP_TOKEN=
HABITS_SUMSUB_SECRET_KEY=
HABITS_SUMSUB_BASE_URL=https://api.sumsub.com

# Sumsub webhook signing secret (Dashboard → Dev space → Webhook manager → Secret key)
# Used to verify x-payload-digest on incoming webhooks at /webhook/v/sumsub
HABITS_SUMSUB_WEBHOOK_SECRET=

# SQLite database for persisted KYC customer records
HABITS_KYC_DATABASE=showcase/sumsub-openai-demo/sumsub-kyc.db

# OpenAI
OPENAI_API_KEY=
