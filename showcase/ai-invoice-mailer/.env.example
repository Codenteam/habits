# OpenAI
HABITS_OPENAI_API_KEY=sk-...

# SMTP credentials (for sending invoice emails)
HABITS_SMTP_HOST=smtp.gmail.com
HABITS_SMTP_PORT=587
HABITS_SMTP_USER=your@email.com
HABITS_SMTP_PASSWORD=your-app-password

# From address shown in sent emails
HABITS_EMAIL_FROM=Your Company <your@email.com>

HABITS_OPENAPI_ENABLED=true
HABITS_MANAGE_ENABLED=true
