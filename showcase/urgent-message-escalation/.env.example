# OpenAI — urgency analysis and acknowledgement detection
HABITS_OPENAI_API_KEY=sk-...

# Slack bot token (xoxb-...) — requires chat:write, channels:history, reactions:read
HABITS_SLACK_BOT_TOKEN=xoxb-...

# Slack app signing secret — required for inbound Events API webhooks
HABITS_SLACK_SIGNING_SECRET=

# On-call / incident channel ID (e.g. C0123456789) where escalations are posted
HABITS_SLACK_CHANNEL_ESCALATION=
