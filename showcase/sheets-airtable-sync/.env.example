# Airtable — https://airtable.com/create/tokens
AIRTABLE_PAT=pat_your_token_here
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_ID=tblYYYYYYYYYYYYYY

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Sheets — spreadsheet ID from the URL
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
# Tab name (quote in GOOGLE_RANGE if it contains spaces)
GOOGLE_SHEET_NAME=Sheet1
# Polling range — include header row (row 1) and data rows below
GOOGLE_RANGE=Sheet1!A1:Z1000

# Required for /api/docs (Swagger UI)
HABITS_OPENAPI_ENABLED=true
