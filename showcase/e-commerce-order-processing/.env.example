# Shopify (Dev Dashboard client credentials)
HABITS_SHOPIFY_SHOP=your-dev-store
HABITS_SHOPIFY_CLIENT_ID=your-client-id
HABITS_SHOPIFY_CLIENT_SECRET=your-client-secret
HABITS_SHOPIFY_WEBHOOK_URL=https://your-subdomain.ngrok-free.app/webhook/v/shopify

# Airtable
AIRTABLE_PAT=your-airtable-pat
AIRTABLE_BASE_ID=appXXXXXXXX
AIRTABLE_TABLE_ID=tblXXXXXXXX

# Slack
HABITS_SLACK_BOT_TOKEN=xoxb-your-token
HABITS_SLACK_DIGEST_CHANNEL=C0123456789

# OpenAI (Slack notification copy)
HABITS_OPENAI_API_KEY=sk-your-key

# Optional — SQLite file for order mirror (default below)
# HABITS_ORDERS_DATABASE=showcase/e-commerce-order-processing/orders.db
