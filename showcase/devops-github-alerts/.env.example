# GitHub — monitor this repository for failed Actions runs
HABITS_GITHUB_TOKEN=ghp_your_token_here
HABITS_GITHUB_OWNER=your-org
HABITS_GITHUB_REPO=your-repo

# Labels must already exist in the repository (comma-separated)
HABITS_GITHUB_ISSUE_LABELS=bug,ci-failure,devops,enhancement

# OpenAI — triage failures and pick a label + Slack copy
HABITS_OPENAI_API_KEY=sk-your-openai-key

# Slack — post alerts to this channel
HABITS_SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
HABITS_SLACK_ALERTS_CHANNEL=C0123456789
