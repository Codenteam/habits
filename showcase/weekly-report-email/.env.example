# OpenAI — drafts the report email body
HABITS_OPENAI_API_KEY=

# Google Sheets OAuth (see README for setup)
HABITS_GOOGLE_SHEETS_CLIENT_ID=
HABITS_GOOGLE_SHEETS_CLIENT_SECRET=
HABITS_GOOGLE_SPREADSHEET_ID=
# A1 notation range for the tab to read (e.g. Weekly Report!A:F)
HABITS_GOOGLE_SHEET_RANGE=Weekly Report!A:F

# SMTP — sends the report email
HABITS_SMTP_HOST=smtp.gmail.com
HABITS_SMTP_PORT=587
HABITS_SMTP_USER=
HABITS_SMTP_PASSWORD=
HABITS_EMAIL_FROM=
HABITS_REPORT_EMAIL_TO=
HABITS_REPORT_EMAIL_SUBJECT=Weekly Performance Report

# Email personalization (greeting and sign-off — not generated by AI)
HABITS_REPORT_STAKEHOLDER_NAME=
HABITS_REPORT_SENDER_NAME=
HABITS_REPORT_SENDER_POSITION=
