# Required secrets for smart-contact-form habit
HABITS_OPENAI_API_KEY=sk-...
HABITS_RECAPTCHA_SITE_KEY=your-recaptcha-enterprise-site-key
HABITS_RECAPTCHA_PROJECT_ID=your-gcp-project-id
HABITS_RECAPTCHA_API_KEY=your-gcp-api-key-with-recaptcha-enterprise-api
HABITS_CONTACT_FORM_RECIPIENT=contact@example.com

# SMTP credentials for sending notification emails
HABITS_SMTP_HOST=smtp.example.com
HABITS_SMTP_PORT=587
HABITS_SMTP_USER=notifications@codenteam.com
HABITS_SMTP_PASSWORD=your-smtp-password
HABITS_SMTP_FROM=Habits Contact Form <no-reply@codenteam.com>
