# Shopify Dev Dashboard app (client credentials grant — same org as dev store)
# https://shopify.dev/docs/apps/build/authentication-authorization/client-credentials-grant

# Store subdomain only, e.g. my-dev-store (NOT my-dev-store.myshopify.com)
HABITS_SHOPIFY_SHOP=your-dev-store

HABITS_SHOPIFY_CLIENT_ID=your-client-id
HABITS_SHOPIFY_CLIENT_SECRET=your-client-secret

# Optional — default product title when create-product workflow input is omitted
HABITS_SHOPIFY_TEST_PRODUCT_TITLE=Habits test product

# Full HTTPS webhook callback for Shopify (required for Configure webhooks). Must end with /webhook/v/shopify
# Example: https://your-subdomain.ngrok-free.app/webhook/v/shopify
HABITS_SHOPIFY_WEBHOOK_URL=
