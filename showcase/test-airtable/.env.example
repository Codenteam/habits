# Airtable PAT — create at https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write
AIRTABLE_PAT=pat_your_token_here

# From your Airtable base URL: https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_ID=tblXXXXXXXXXXXXXX
