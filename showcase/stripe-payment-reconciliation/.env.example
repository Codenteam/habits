# Stripe (test mode recommended while developing)
HABITS_STRIPE_SECRET_KEY=sk_test_your_key_here

# OpenAI
HABITS_OPENAI_API_KEY=sk-your-openai-key-here

# Gmail SMTP (use an App Password — https://myaccount.google.com/apppasswords)
HABITS_SMTP_HOST=smtp.gmail.com
HABITS_SMTP_PORT=587
HABITS_SMTP_USER=you@gmail.com
HABITS_SMTP_PASSWORD=your-gmail-app-password
HABITS_EMAIL_FROM="Habits Payments <you@gmail.com>"

# Inbox that receives payment notifications
HABITS_PAYMENT_NOTIFY_EMAIL=finance@yourcompany.com

# QuickBooks Online (sandbox recommended while developing)
HABITS_QUICKBOOKS_CLIENT_ID=your_intuit_client_id
HABITS_QUICKBOOKS_CLIENT_SECRET=your_intuit_client_secret
HABITS_QUICKBOOKS_ENV=sandbox
# Company ID from OAuth callback URL (?realmId=...)
HABITS_QUICKBOOKS_REALM_ID=your_realm_id
# CustomerRef value — create a customer in your QBO sandbox first
HABITS_QUICKBOOKS_CUSTOMER_ID=1
