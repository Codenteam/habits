# OpenAI — generates the Slack notification text
HABITS_OPENAI_API_KEY=

# HubSpot Private App token (CRM API + webhooks)
HABITS_HUBSPOT_ACCESS_TOKEN=

# HubSpot Private App client secret (webhook signature verification — NOT the access token)
HABITS_HUBSPOT_CLIENT_SECRET=

# Slack bot token (posts the notification)
HABITS_SLACK_BOT_TOKEN=

# Slack channel ID where new-lead alerts are posted (e.g. C08XXXXXXXX)
HABITS_SLACK_CHANNEL_ID=
