# OpenAI — urgency analysis and acknowledgement detection
HABITS_OPENAI_API_KEY=sk-...

# WhatsApp Cloud API — permanent access token from Meta Business
HABITS_WHATSAPP_ACCESS_TOKEN=

# WhatsApp Business phone number ID (from Meta App → WhatsApp → API Setup)
HABITS_WHATSAPP_PHONE_NUMBER_ID=

# Webhook verify token — same string in Meta App Dashboard webhook settings
HABITS_WHATSAPP_VERIFY_TOKEN=

# Meta App Secret — verifies X-Hub-Signature-256 on inbound webhook POSTs (App settings → Basic)
HABITS_WHATSAPP_APP_SECRET=

# Session template — see README "Create a message template" (or docs/integrations/whatsapp Step 10)
HABITS_WHATSAPP_SESSION_TEMPLATE=hello_world
HABITS_WHATSAPP_SESSION_TEMPLATE_LANGUAGE=en_US

# On-call phone number that receives escalation messages (E.164, e.g. +14155238886)
HABITS_WHATSAPP_ESCALATION_PHONE=
